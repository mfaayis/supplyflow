# ──────────────────────────────────────────────────
# SupplyFlow Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# For Vercel: set these in your Vercel project dashboard under
#   Settings → Environment Variables
# ──────────────────────────────────────────────────

# GEMINI_API_KEY: Required if the app uses Gemini AI features.
# For local dev: set in .env.local (never commit this file).
# For Vercel: add via Dashboard → Settings → Environment Variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# SUPABASE — Required for cloud data persistence and user login.
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
