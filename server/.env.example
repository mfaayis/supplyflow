/**
 * SUPPLYFLOW — Server Environment Variables
 * Copy to server/.env and fill in your values.
 * This file is server-side only. NEVER expose these to the frontend.
 */

# ── Supabase (Server-side admin access) ───────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Market Data ───────────────────────────────────────────────────────────────
# Provider: 'twelvedata' | 'polygon' (twelvedata is default)
MARKET_DATA_PROVIDER=twelvedata

# Twelve Data API key — get from https://twelvedata.com (free tier works)
MARKET_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY_HERE

# ── TradingView Webhook ───────────────────────────────────────────────────────
# Generate any random secret string — put the same value in your TradingView alert
WEBHOOK_SECRET=your-super-secret-webhook-token-here

# ── Monitoring Engine ─────────────────────────────────────────────────────────
# Proximity alert threshold (0.0 – 1.0). Default: 0.80 = 80% of distance
PROXIMITY_ALERT_THRESHOLD=0.80

# How often (ms) the engine polls Supabase for active trades as a safety net
MONITOR_POLL_INTERVAL_MS=30000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Set to true ONLY if you get UNABLE_TO_VERIFY_LEAF_SIGNATURE errors in local Windows dev
# Will automatically be ignored in production.
IGNORE_TLS_ERRORS=false
